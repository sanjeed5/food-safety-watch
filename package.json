{
  "name": "food-safety-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "pnpm build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "maplibre-gl": "^6.4.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.2.0",
    "typescript": "^5.5.2",
    "vite": "^8.2.1",
    "vitest": "~4.1.0",
    "wrangler": "^4.124.0"
  }
}
